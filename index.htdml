    <!-- JAVASCRIPT LOGIC -->
    <script>
        // --- 1. Mobile Navigation Toggle ---
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Close menu on link click
        mobileMenu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
        });

        // --- 2. Mini Random Curiosity Generator Data & Logic ---
        const facts = [
            {
                category: "🎮 Videojuegos",
                text: "En el Mario Bros original de 1985, las nubes y los arbustos usan exactamente el mismo sprite, pero recoloreado."
            },
            {
                category: "🌌 Ciencia Espacial",
                text: "Un día en Venus es más largo que un año entero en Venus. Tarda más en girar sobre su propio eje que alrededor del Sol."
            },
            {
                category: "🐙 Biología",
                text: "Los pulpos tienen tres corazones, nueve cerebros y su sangre es de color azul debido al cobre que transporta oxígeno."
            },
            {
                category: "📜 Historia",
                text: "La guerra más corta de la historia duró entre 38 y 45 minutos. Fue entre Gran Bretaña y Zanzíbar en 1896."
            },
            {
                category: "🧠 Neurociencia",
                text: "El cerebro humano produce suficiente electricidad para encender una bombilla LED pequeña mientras estás despierto."
            },
            {
                category: "🦈 Naturaleza",
                text: "Los tiburones existían en la Tierra antes de que aparecieran los primeros árboles."
            }
        ];

        function generateRandomFact() {
            const box = document.getElementById('curiosity-box');
            const categoryEl = document.getElementById('curiosity-category');
            const textEl = document.getElementById('curiosity-text');

            // Quick fade animation
            box.style.opacity = '0';
            box.style.transform = 'translateY(10px)';

            setTimeout(() => {
                const randomFact = facts[Math.floor(Math.random() * facts.length)];
                categoryEl.textContent = randomFact.category;
                textEl.textContent = `"${randomFact.text}"`;

                box.style.opacity = '1';
                box.style.transform = 'translateY(0)';
            }, 200);
        }

        // --- 3. Video Preview Modal Logic ---
        function openVideoModal(imgSrc, title, desc) {
            document.getElementById('modal-img').src = imgSrc;
            document.getElementById('modal-title').textContent = title;
            document.getElementById('modal-desc').textContent = desc;

            const modal = document.getElementById('video-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeVideoModal() {
            const modal = document.getElementById('video-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        // Close Modal when clicking outside container
        document.getElementById('video-modal').addEventListener('click', (e) => {
            if (e.target.id === 'video-modal') {
                closeVideoModal();
            }
        });

        // --- 4. Animated Stats Counter On Scroll ---
        let animated = false;
        const counters = document.querySelectorAll('.stat-counter');

        function animateCounters() {
            counters.forEach(counter => {
                const target = +counter.getAttribute('data-target');
                const duration = 2000; // ms
                const stepTime = 20;
                const steps = duration / stepTime;
                const increment = target / steps;
                let current = 0;

                const timer = setInterval(() => {
                    current += increment;
                    if (current >= target) {
                        counter.textContent = '+' + target.toLocaleString();
                        clearInterval(timer);
                    } else {
                        counter.textContent = '+' + Math.floor(current).toLocaleString();
                    }
                }, stepTime);
            });
        }

        // Intersection Observer for triggering counters when visible
        const communitySection = document.getElementById('comunidad');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting && !animated) {
                    animateCounters();
                    animated = true;
                }
            });
        }, { threshold: 0.3 });

        if (communitySection) {
            observer.observe(communitySection);
        }
    </script>
</body>
</html>